paths:
  - {{spool_dir}}/rigsignal-memory-*.ndjson
exclude_files: ['.tmp$', '.gz$']
prospector.scanner.fingerprint:
  enabled: true
  offset: 0
  length: 1024
tags: {{to_json tags}}
parsers:
  - ndjson:
      target: ""
      overwrite_keys: true
{{#if processors}}
processors:
{{processors}}
{{/if}}
